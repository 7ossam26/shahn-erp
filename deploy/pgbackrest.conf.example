[global]
repo1-path=/var/lib/pgbackrest
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_FROM_SEPARATE_KEY_RECOVERY_SOURCE
repo1-retention-full-type=time
repo1-retention-full=30
# Leave archive retention at its default: protect WAL for all retained backups.
start-fast=y
archive-check=y
archive-timeout=120
process-max=2
log-level-console=info
log-level-file=off
lock-path=/tmp/pgbackrest

[erp]
pg1-path=/var/lib/postgresql/18/docker
pg1-socket-path=/var/run/postgresql
pg1-user=shahn_backup
pg1-database=shahn_erp
# db runs archive-push as the postgres OS owner. A separate backup SQL role performs backup control.
