# Copy using npm run dev:setup (generates a random local-only password).
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=4100
DATABASE_URL=postgresql://REPLACE_RUNTIME_ROLE:REPLACE_PASSWORD@127.0.0.1:15418/shahn_p01_dev
MIGRATION_DATABASE_URL=postgresql://REPLACE_MIGRATION_ROLE:REPLACE_PASSWORD@127.0.0.1:15418/shahn_p01_dev
DEV_DB_USER=shahn_p01_dev
DEV_DB_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD
DEV_DB_PORT=15418
VITE_ENABLE_DEMOS=true
# P02 uses a separately provisioned shared issuer; no committed password or public signup.
# The isolated development installer writes these in ignored .env.p02.local.
# OIDC_ISSUER=https://identity.example/realms/company
# OIDC_CLIENT_ID=erp
# OIDC_CLIENT_SECRET=REPLACE_SERVER_SECRET
# OIDC_ADMIN_CLIENT_ID=erp-identity
# OIDC_ADMIN_CLIENT_SECRET=REPLACE_ISSUER_ADMIN_SECRET
# SESSION_ENCRYPTION_KEY=REPLACE_64_LOWERCASE_HEX

# P25 managed deployment: deploy/runtime.env.example and separate mounted secret files.
# OPERATIONS_MODE=restore disables mutations/outbound worker polling until operator review.
# DEPLOYMENT_MANAGED=true
# APP_COMPANY_ID=REPLACE_COMPANY_UUID
# RELEASE_ID=REPLACE_RELEASE_SHA
# CONFIG_VERSION=REPLACE_CONFIG_REVISION
# DATABASE_POOL_MAX=8
# OIDC_AUDIENCE=erp
# OIDC_REDIRECT_URI=https://erp.example.invalid/api/v1/access/callback
# BACKUP_REPOSITORY_REFERENCE=REPLACE_REPOSITORY_LOCATION
# BACKUP_KEY_REFERENCE=REPLACE_SEPARATE_KEY_VAULT_REFERENCE
