{
  "name": "shahn-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.21.0",
    "npm": "12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint apps packages tests scripts && prettier --check apps packages tests scripts *.json *.mjs .env.example deploy/compose.dev.yml",
    "format": "prettier --write apps packages tests scripts *.json *.mjs .env.example deploy/compose.dev.yml",
    "typecheck": "tsc -b",
    "build": "node scripts/build.mjs",
    "test:unit": "node scripts/build-packages.mjs && vitest run --config vitest.unit.config.ts",
    "test:db": "node scripts/build-packages.mjs && vitest run --config vitest.db.config.ts",
    "test:browser": "node scripts/build.mjs && playwright test",
    "test:phase": "node scripts/test-phase.mjs",
    "db:migrate": "node packages/database/dist/cli.js migrate",
    "db:status": "node packages/database/dist/cli.js status",
    "seed:dev": "node packages/database/dist/cli.js seed",
    "dev:setup": "node scripts/dev-setup.mjs",
    "db:up": "docker compose --env-file .env -f deploy/compose.dev.yml up -d --wait --wait-timeout 60",
    "db:stop": "docker compose --env-file .env -f deploy/compose.dev.yml stop db",
    "start:api": "node apps/api/dist/main.js",
    "start:worker": "node apps/worker/dist/main.js",
    "start:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1 --port 5173 --strictPort",
    "test:runner": "node --test tests/runner.test.mjs",
    "p02:setup": "node scripts/build.mjs && node scripts/p02-setup.mjs",
    "p02:up": "node scripts/p02-up.mjs",
    "dev:p02": "node --env-file=.env.p02.local scripts/dev.mjs",
    "access:bootstrap": "node scripts/access-bootstrap.mjs",
    "test:p02:browser": "node scripts/build.mjs && playwright test --config playwright.p02.config.ts",
    "test:p03:browser": "node scripts/build.mjs && playwright test --config playwright.p03.config.ts",
    "test:p04:browser": "node scripts/build.mjs && playwright test --config playwright.p04.config.ts",
    "p04:trial": "node scripts/build.mjs && node scripts/p04-trial.mjs",
    "p03:trial": "node scripts/build.mjs && node scripts/p03-trial.mjs",
    "test:p05:browser": "node scripts/build.mjs && playwright test --config playwright.p05.config.ts",
    "p05:trial": "node scripts/build.mjs && node scripts/p05-trial.mjs",
    "test:p06:browser": "node scripts/build.mjs && playwright test --config playwright.p06.config.ts",
    "p06:trial": "node scripts/build.mjs && node scripts/p06-trial.mjs",
    "test:p07:browser": "node scripts/build.mjs && playwright test --config playwright.p07.config.ts",
    "p07:trial": "node scripts/build.mjs && node scripts/p07-trial.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.1.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
